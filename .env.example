# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Luma API Configuration
# Get your API key from: https://lu.ma/settings/developer
# Requires Luma Plus subscription ($69/mo)
LUMA_API_KEY=luma_...

# Optional: Luma Webhook Secret (for verifying webhook signatures)
LUMA_WEBHOOK_SECRET=your-webhook-secret

# Vercel Cron Secret (for securing cron endpoints)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret
